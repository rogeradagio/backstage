<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_backstage_web_receipt_incident_wizard_form" model="ir.ui.view">
        <field name="name">backstage.web.receipt.incident.wizard.form</field>
        <field name="model">backstage.web.receipt.incident.wizard</field>
        <field name="arch" type="xml">
            <form>
                <p>
                    Tell us why each line differs. The customer will not be told the order is ready
                    until the difference is sorted out.
                </p>
                <field name="picking_id" invisible="1"/>
                <field name="line_ids" nolabel="1">
                    <list editable="bottom" create="0" delete="0">
                        <field name="product_id"/>
                        <field name="qty_expected"/>
                        <field name="qty_received"/>
                        <field name="reason"/>
                        <field name="note" placeholder="Optional"/>
                    </list>
                </field>
                <footer>
                    <button name="action_confirm" type="object" string="Confirm and validate" class="btn-primary"/>
                    <button special="cancel" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
