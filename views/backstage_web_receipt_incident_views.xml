<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_backstage_web_receipt_incident_list" model="ir.ui.view">
        <field name="name">backstage.web.receipt.incident.list</field>
        <field name="model">backstage.web.receipt.incident</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'resolved'" decoration-danger="state == 'open' and reason == 'unspecified'">
                <field name="create_date" string="Date" widget="date"/>
                <field name="warehouse_id"/>
                <field name="picking_id"/>
                <field name="sale_order_id" optional="show"/>
                <field name="product_id"/>
                <field name="qty_expected"/>
                <field name="qty_received"/>
                <field name="reason"/>
                <field name="note" optional="hide"/>
                <field name="supply_picking_id" optional="hide"/>
                <field name="state" widget="badge" decoration-warning="state == 'open'" decoration-success="state == 'resolved'"/>
            </list>
        </field>
    </record>

    <record id="view_backstage_web_receipt_incident_form" model="ir.ui.view">
        <field name="name">backstage.web.receipt.incident.form</field>
        <field name="model">backstage.web.receipt.incident</field>
        <field name="arch" type="xml">
            <form create="false">
                <header>
                    <button name="action_resolve" type="object" string="Resolve" class="btn-primary"
                            invisible="state != 'open'"
                            groups="stock.group_stock_manager,backstage.group_backstage_manager"/>
                    <button name="action_reopen" type="object" string="Reopen"
                            invisible="state != 'resolved'"
                            groups="stock.group_stock_manager,backstage.group_backstage_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="open,resolved"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="product_id" readonly="1" options="{'no_open': True}"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="picking_id" readonly="1"/>
                            <field name="supply_picking_id"/>
                            <field name="warehouse_id"/>
                            <field name="sale_order_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="qty_expected" readonly="1"/>
                            <field name="qty_received" readonly="1"/>
                            <field name="difference" decoration-danger="difference &lt; 0"/>
                            <field name="reason" readonly="state == 'resolved'"/>
                        </group>
                    </group>
                    <group>
                        <field name="note" readonly="state == 'resolved'" placeholder="What the store saw…"/>
                        <!-- Només els administradors resolen: la botiga veu la resolució, però no l'edita. -->
                        <field name="resolution" readonly="state == 'resolved' or not can_resolve"
                               invisible="state == 'draft' or (not can_resolve and not resolution)"
                               placeholder="What was done: resent, credited, written off…"/>
                        <field name="resolved_by_id" invisible="state != 'resolved'"/>
                        <field name="resolved_date" invisible="state != 'resolved'"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_backstage_web_receipt_incident_search" model="ir.ui.view">
        <field name="name">backstage.web.receipt.incident.search</field>
        <field name="model">backstage.web.receipt.incident</field>
        <field name="arch" type="xml">
            <search>
                <field name="picking_id"/>
                <field name="sale_order_id"/>
                <field name="product_id"/>
                <field name="warehouse_id"/>
                <filter name="open" string="Open" domain="[('state', '=', 'open')]"/>
                <filter name="resolved" string="Resolved" domain="[('state', '=', 'resolved')]"/>
                <separator/>
                <filter name="unspecified" string="No reason given" domain="[('reason', '=', 'unspecified')]"/>
                <group>
                    <filter name="group_warehouse" string="Store" context="{'group_by': 'warehouse_id'}"/>
                    <filter name="group_reason" string="Reason" context="{'group_by': 'reason'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_backstage_web_receipt_incident" model="ir.actions.act_window">
        <field name="name">Receipt incidents</field>
        <field name="res_model">backstage.web.receipt.incident</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '!=', 'draft')]</field>
        <field name="context">{'search_default_open': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No open receipt incidents</p>
            <p>When a store receives less, more or something else than was sent for a web order,
               the difference shows up here until someone resolves it. Shortages that arrive later close by themselves.</p>
        </field>
    </record>
</odoo>
