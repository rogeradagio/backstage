<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view_backstage" model="ir.ui.view">
        <field name="name">product.template.form.backstage</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <field name="backstage_stock_visible" invisible="1"/>
                <button name="action_backstage_stock_preview" type="object" class="oe_stat_button"
                        icon="fa-cloud-upload" invisible="not backstage_stock_visible"
                        groups="backstage.group_backstage_user">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Stock in</span>
                        <span class="o_stat_text">Magento</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
