#. module: backstage
#. odoo-python
#: code:addons/backstage/models/sale_order.py:0
msgid ""
"%(count)s Magento orders share the number %(ref)s. Fill in the store view of"
" the order."
msgstr ""
"Hay %(count)s pedidos de Magento con el número %(ref)s. Indica la vista de "
"tienda del pedido."

#. module: backstage
#. odoo-python
#: code:addons/backstage/models/account_move.py:0
msgid ""
"%(doc)s was not sent to Magento: these lines have no Magento line "
"(%(products)s). Link the order again from its Magento tab."
msgstr ""
"No se ha enviado %(doc)s a Magento: estas líneas no tienen ninguna línea "
"correspondiente en Magento (%(products)s). Vuelve a vincular el pedido desde"
" la pestaña Magento."

#. module: backstage
#. odoo-python
#: code:addons/backstage/models/stock_picking.py:0
