#. module: backstage
#: model_terms:ir.ui.view,arch_db:backstage.view_backstage_backend_form
msgid ""
"<strong>Disabled.</strong> Backstage is not sending anything to Magento.\n"
"                        Test the connection, map the sources and set up the pickup stores, then enable it."
msgstr ""
"<strong>Desactivado.</strong> Backstage no envía nada a Magento. Prueba la "
"conexión, asigna las fuentes y configura las tiendas de recogida, y después "
"actívalo."

#. module: backstage
#: model_terms:ir.ui.view,arch_db:backstage.view_backstage_backend_form
msgid ""
"<strong>Enabled, stealth mode ON.</strong> Everything is sent to Magento, but customers receive\n"
"                        no e-mail about their orders. Work a few orders as usual and check that <em>To review</em>\n"
"                        stays empty before notifying customers."
msgstr ""
"<strong>Activado, stealth mode ON.</strong> Se envía todo a Magento, pero "
"los clientes no reciben ningún correo sobre sus pedidos. Gestiona algunos "
"pedidos como de costumbre y comprueba que <em>Por revisar</em> se mantiene "
"vacío antes de avisar a los clientes."

#. module: backstage
#: model_terms:ir.ui.view,arch_db:backstage.view_backstage_backend_form
msgid ""
"<strong>Enabled.</strong> Everything is sent to Magento, and customers receive\n"
"                        Magento e-mails about their orders."
msgstr ""
"<strong>Activado.</strong> Se envía todo a Magento, y los clientes reciben "
"los correos de Magento sobre sus pedidos."

